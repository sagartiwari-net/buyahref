---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const title = 'Privacy Policy » Buy Ahrefs';
const description =
  'Privacy Policy for BuyAhref.com — how we handle contact details, analytics, and links to ToolsMandi signup.';
---

<BaseLayout title={title} description={description} canonicalPath="/privacy">
  <section class="section-pad">
    <div class="container-narrow max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="heading-display mt-4 text-4xl md:text-5xl">Privacy Policy</h1>
      <div class="mt-8 space-y-5 text-base leading-relaxed text-slate">
        <p>Last updated: November 24, 2026</p>
        <p>
          BuyAhref.com (“we”, “us”) respects your privacy. This policy explains what information we collect on this
          marketing website and how it is used.
        </p>
        <h2 class="heading-display pt-2 text-2xl text-ink">Information we collect</h2>
        <ul class="list-disc space-y-2 pl-5">
          <li>Contact details you voluntarily send via email, phone, or contact forms</li>
          <li>Basic technical data such as browser type, pages visited, and approximate location via analytics/host logs</li>
          <li>Account and payment data processed by ToolsMandi when you sign up or buy (subject to their privacy policy)</li>
        </ul>
        <h2 class="heading-display pt-2 text-2xl text-ink">How we use information</h2>
        <ul class="list-disc space-y-2 pl-5">
          <li>To respond to support and sales inquiries</li>
          <li>To improve site performance and SEO content</li>
          <li>To route you to ToolsMandi for signup, login, and billing</li>
        </ul>
        <h2 class="heading-display pt-2 text-2xl text-ink">Third-party services</h2>
        <p>
          Signup, login, and purchases occur on
          <a href={SITE.signupUrl} class="text-brand hover:underline" rel="noopener noreferrer">toolsmandi.com</a>.
          We do not store your payment card details on BuyAhref.com.
        </p>
        <h2 class="heading-display pt-2 text-2xl text-ink">Contact</h2>
        <p>
          Questions about privacy: <a href={`mailto:${SITE.email}`} class="text-brand hover:underline">{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
