---
import type { Tool } from '../lib/tools';
import { TOOL_BUY_URL, toolAlt, toolThumb, toolThumbMobile } from '../lib/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const thumb = toolThumb(tool);
const thumbMobile = toolThumbMobile(tool);
const alt = toolAlt(tool);
const hasThumb = Boolean(tool.thumbnail);
---

<div
  class="rounded-2xl border border-line bg-paper p-3 shadow-[0_16px_40px_rgba(15,23,42,0.08)] ring-1 ring-black/[0.03]"
>
  {
    hasThumb && thumb ? (
      <div class="overflow-hidden rounded-xl bg-canvas shadow-[inset_0_0_0_1px_rgba(15,23,42,0.06)]">
        <img
          src={thumbMobile || thumb}
          srcset={
            tool.thumbnailMobile && tool.thumbnail
              ? `${tool.thumbnailMobile} 640w, ${tool.thumbnail} 960w`
              : undefined
          }
          sizes="280px"
          alt={alt}
          width="960"
          height="540"
          class="block h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="flex items-center gap-4 px-2 pt-2">
        <div class="grid h-16 w-16 shrink-0 place-items-center rounded-xl bg-canvas">
          {thumb ? (
            <img
              src={thumb}
              alt={alt}
              width="48"
              height="48"
              class="h-10 w-10 object-contain"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="font-display text-lg font-bold text-brand" aria-hidden="true">
              {tool.name.slice(0, 1)}
            </span>
          )}
        </div>
        <div class="min-w-0">
          <p class="truncate font-display text-base font-bold text-ink">{tool.name}</p>
          <p class="mt-0.5 text-[11px] font-bold uppercase tracking-[0.14em] text-brand">Group Buy</p>
        </div>
      </div>
    )
  }

  <div class="px-2 pb-2 pt-4">
    <ul class="space-y-2 text-sm text-slate">
      <li>Affordable group-buy access</li>
      <li>20+ premium tools in one plan</li>
      <li>Instant signup on ToolsMandi</li>
    </ul>

    <a href={TOOL_BUY_URL} class="btn-primary mt-5 w-full !py-3 text-xs" rel="noopener noreferrer">
      Buy {tool.name} Group Buy
    </a>
  </div>
</div>
