---
import { SITE, NAV } from '../lib/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur-md">
  <div class="container-narrow flex items-center justify-between gap-4 px-5 py-4 md:px-8">
    <Logo />

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        NAV.map((item) => {
          const active =
            item.href === '/'
              ? path === '/'
              : path === item.href || path.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'font-display text-sm font-semibold tracking-wide',
                active ? 'text-brand' : 'text-slate hover:text-brand',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href={SITE.signupPage} class="btn-primary !px-5 !py-2.5 text-xs md:text-sm">
        Sign Up
      </a>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-line text-ink md:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="sr-only">Menu</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line bg-canvas px-5 py-4 md:hidden" hidden>
    <nav class="flex flex-col gap-3" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a href={item.href} class="font-display text-base font-semibold text-ink">
            {item.label}
          </a>
        ))
      }
      <a href={SITE.signupPage} class="btn-primary mt-2">Sign Up</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.hasAttribute('hidden') === false;
    if (!panel || !toggle) return;
    if (open) {
      panel.hidden = true;
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    } else {
      panel.hidden = false;
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
    }
  });
</script>
