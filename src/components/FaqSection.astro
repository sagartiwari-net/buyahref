---
import type { FaqItem } from '../lib/faq';
import { SITE_FAQ } from '../lib/faq';

interface Props {
  items?: FaqItem[];
  eyebrow?: string;
  heading?: string;
  intro?: string;
  id?: string;
  imageSrc?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  items = SITE_FAQ,
  eyebrow = 'FAQ',
  heading = 'Frequently asked questions',
  intro = 'Common questions about BuyAhref group buy SEO tools, access, and support.',
  id = 'faq',
  imageSrc = '/images/hero-group-buy.webp',
  imageAlt = 'BuyAhref group buy SEO tools dashboard — Ahrefs access, plans, and member support FAQ',
  imageWidth = 516,
  imageHeight = 686,
} = Astro.props;
---

<section id={id} class="section-pad border-b border-line bg-paper">
  <div class="container-narrow">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14">
      <div class="min-w-0">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="heading-display mt-3 text-3xl md:text-4xl">{heading}</h2>
        <p class="mt-4 text-base leading-relaxed text-slate md:text-lg">{intro}</p>

        <div
          class="mt-10 divide-y divide-line rounded-[24px] border border-line bg-canvas/60 shadow-[0_14px_40px_rgba(15,23,42,0.05)]"
        >
          {
            items.map((item) => (
              <details class="group px-5 py-1 md:px-7">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-base font-bold text-ink outline-none marker:content-none [&::-webkit-details-marker]:hidden">
                  <span>{item.question}</span>
                  <span
                    class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line bg-paper text-lg leading-none text-brand transition group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <p class="pb-5 pr-10 text-sm leading-relaxed text-slate md:text-base">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>

      <figure class="relative mx-auto w-full max-w-[240px] lg:sticky lg:top-28 lg:mx-0 lg:ml-auto lg:max-w-[260px]">
        <div
          class="pointer-events-none absolute -inset-3 -z-10 rounded-[24px] bg-[radial-gradient(circle_at_30%_20%,_rgba(91,72,224,0.12),_transparent_55%)]"
          aria-hidden="true"
        >
        </div>
        <img
          src={imageSrc}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          class="h-auto w-full rounded-[20px] shadow-[0_18px_44px_rgba(15,23,42,0.12)] ring-1 ring-black/[0.06]"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-3 text-center text-xs font-medium tracking-wide text-slate lg:text-left">
          BuyAhref · Group buy SEO tools
        </figcaption>
      </figure>
    </div>
  </div>
</section>
