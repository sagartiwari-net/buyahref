---
import type { Tool } from '../lib/tools';
import { toolAlt, toolThumb, toolThumbMobile } from '../lib/tools';

interface Props {
  tool: Tool;
  eager?: boolean;
}

const { tool, eager = false } = Astro.props;
const thumb = toolThumb(tool);
const thumbMobile = toolThumbMobile(tool);
const alt = toolAlt(tool);
const isWide = Boolean(tool.thumbnail);
const categoryLabel: Record<string, string> = {
  seo: 'SEO & Research',
  writing: 'AI Writing',
  creative: 'Creative',
  amazon: 'Amazon',
  learning: 'Learning',
  streaming: 'Streaming',
  other: 'Premium tool',
};
---

<figure
  class="rounded-2xl border border-line bg-paper p-3 shadow-[0_18px_48px_rgba(15,23,42,0.08)] ring-1 ring-black/[0.03] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_24px_56px_rgba(15,23,42,0.12)] sm:p-4"
>
  {
    isWide && thumb ? (
      <div class="overflow-hidden rounded-xl bg-canvas shadow-[inset_0_0_0_1px_rgba(15,23,42,0.06)]">
        <img
          src={thumbMobile || thumb}
          srcset={
            tool.thumbnailMobile && tool.thumbnail
              ? `${tool.thumbnailMobile} 640w, ${tool.thumbnail} 960w`
              : undefined
          }
          sizes="(max-width: 1023px) 320px, 360px"
          alt={alt}
          width="960"
          height="540"
          class="block h-auto w-full"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      </div>
    ) : (
      <div class="p-3 sm:p-4">
        <div class="relative flex aspect-square items-center justify-center rounded-xl bg-canvas shadow-[inset_0_0_0_1px_rgba(15,23,42,0.06)]">
          <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,_rgba(91,72,224,0.12),_transparent_55%)]"
            aria-hidden="true"
          />
          {thumb ? (
            <img
              src={thumb}
              alt={alt}
              width="128"
              height="128"
              class="relative z-10 h-20 w-20 rounded-2xl bg-paper object-contain p-3 shadow-[0_12px_28px_rgba(15,23,42,0.12)] sm:h-24 sm:w-24"
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : 'auto'}
              decoding="async"
            />
          ) : (
            <div
              class="relative z-10 grid h-24 w-24 place-items-center rounded-2xl bg-brand font-display text-2xl font-extrabold text-white"
              aria-hidden="true"
            >
              {tool.name.slice(0, 1)}
            </div>
          )}
        </div>
        <figcaption class="mt-5 text-center">
          <p class="font-display text-lg font-bold text-ink">{tool.name}</p>
          <p class="mt-1 text-xs font-bold uppercase tracking-[0.16em] text-brand">
            {categoryLabel[tool.category] ?? 'Group Buy'}
          </p>
          <p class="mt-3 text-sm text-slate">Included in BuyAhref membership</p>
        </figcaption>
      </div>
    )
  }
</figure>
