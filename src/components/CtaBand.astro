---
import { SITE } from '../lib/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Ready to get Ahrefs at group-buy pricing?',
  text = 'Create your account on ToolsMandi and unlock Ahrefs plus 20+ premium SEO and creative tools.',
} = Astro.props;
---

<section class="section-pad">
  <div class="container-narrow">
    <div class="relative overflow-hidden rounded-[28px] border border-line bg-brand-soft px-6 py-12 shadow-[0_18px_48px_rgba(103,84,233,0.12)] md:px-12 md:py-16">
      <div
        class="pointer-events-none absolute -right-10 -top-10 h-48 w-48 rounded-full bg-brand/20 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-12 left-1/3 h-40 w-40 rounded-full bg-gold/30 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative max-w-2xl">
        <h2 class="heading-display text-3xl md:text-4xl">{heading}</h2>
        <p class="mt-4 text-base leading-relaxed text-slate md:text-lg">{text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={SITE.signupPage} class="btn-primary">Sign Up Now</a>
          <a href={SITE.signupUrl} class="btn-ghost" rel="noopener noreferrer">Buy on ToolsMandi</a>
        </div>
      </div>
    </div>
  </div>
</section>
