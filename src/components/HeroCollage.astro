---
/**
 * Hero visual — no slider, one LCP image.
 * Desktop adds soft depth layers behind the primary shot.
 * Aspect-ratio is reserved so the figure never causes CLS on mobile.
 */
const primary = {
  src: '/images/header-site-audit.webp',
  alt: 'Ahrefs Site Audit on BuyAhref group buy — site health, backlink profile, and SEO overview',
  width: 420,
  height: 558,
};

const layers = [
  {
    src: '/images/header-keyword-explorer.webp',
    width: 420,
    height: 558,
    class: 'left-0 top-[6%] hidden w-[36%] -rotate-[5deg] lg:block',
  },
  {
    src: '/images/header-backlink-analysis.webp',
    width: 420,
    height: 558,
    class: 'right-0 top-[6%] hidden w-[36%] rotate-[5deg] lg:block',
  },
];
---

<div class="hero-visual relative mx-auto w-full max-w-[300px] sm:max-w-[340px] lg:max-w-[520px]">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    {
      layers.map((shot) => (
        <img
          src={shot.src}
          alt=""
          width={shot.width}
          height={shot.height}
          class:list={[
            'absolute rounded-[18px] opacity-90 shadow-[0_16px_40px_rgba(15,23,42,0.12)] ring-1 ring-black/[0.05]',
            shot.class,
          ]}
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>

  <figure
    class="relative z-10 mx-auto w-full overflow-hidden rounded-[22px] shadow-[0_24px_60px_rgba(15,23,42,0.16)] ring-1 ring-black/[0.06] lg:w-[56%]"
    style={`aspect-ratio: ${primary.width} / ${primary.height}`}
  >
    <img
      src={primary.src}
      alt={primary.alt}
      width={primary.width}
      height={primary.height}
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </figure>
</div>
