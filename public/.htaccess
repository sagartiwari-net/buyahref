# BuyAhref — Apache (aaPanel) static site rules for /dist

# Custom 404
ErrorDocument 404 /404.html

# Long cache for hashed / immutable static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"

  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted Astro assets + fonts/images: long immutable cache
  <FilesMatch "\.(?:css|js|mjs|woff2|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: short cache so deploys show up quickly
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>

  # Crawl / ads files
  <FilesMatch "^(?:robots\.txt|ads\.txt|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Security / type sniffing
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Prefer compressed responses when available
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
